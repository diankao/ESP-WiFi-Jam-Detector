# esp-wifi-jammer-detector, Waveshare ESP32-C5-MINI-KIT-U (headless, 4 MB Flash, no PSRAM).
CONFIG_IDF_TARGET="esp32c5"

# Target board selection.
CONFIG_JD_BOARD_C5_MINI_KIT=y

# Flash: 4 MB embedded flash (XMC), DIO 80 MHz.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# Serial OTA (tools/pc_upgrader.py): an upgraded app boots as PENDING_VERIFY
# and must call esp_ota_mark_app_valid_cancel_rollback() (main/ota_upgrade.c
# does so after a 10 s self-check, or on the ota_confirm command). If it never
# does, the bootloader re-boots the previous ota slot on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Console & RTOS: same base settings as esp-sdr's sdkconfig.defaults.esp32c5.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_PM_ENABLE is not set

# Receiver: same radio settings as esp-sdr's sdkconfig.defaults(.esp32c5).
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
# Leave enough non-modem SRAM for static data, task stacks, and DSP/detector heap.
# Receive-only sniffer mode (WIFI_MODE_NULL) does not need large lwIP/TX/RX pools.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
# CONFIG_ESP_PHY_IRAM_OPT is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set

# No PSRAM on ESP32-C5-MINI-KIT-U.
# CONFIG_SPIRAM is not set
